# ── LLM 配置（三选一，默认 NVIDIA NIM 免费额度）──────────────────
# provider: nim / deepseek / openai / openai_compatible
ASTOCK_PROVIDER=nim

# ── 方案 A（默认）：NVIDIA NIM 免费 API ─────────────────────────
# 申请地址：https://build.nvidia.com — 注册后任意模型页获取 nvapi- 开头的 key
# 免费额度：开发者账号 1000 credits（每次选股约 30-40 次调用）
NVIDIA_API_KEY=

# ── 方案 B：DeepSeek ───────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-xxx
# ASTOCK_PROVIDER=deepseek

# ── 方案 C：OpenAI ─────────────────────────────────────────────
# OPENAI_API_KEY=sk-xxx
# ASTOCK_PROVIDER=openai

# ── 方案 D：任意 OpenAI 兼容网关（9Router / AI Router / 自建代理）──
# ASTOCK_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_API_KEY=sk-xxx
# ASTOCK_BASE_URL=https://your-relay.example/v1
# ASTOCK_MODEL=<你的网关支持的 model 名>

# ── 可选：覆盖默认模型 ─────────────────────────────────────────
# NIM 可选模型（2026-09 实测可用，GET /v1/models 可列全部 82 个）：
#   deepseek-ai/deepseek-v4.1-flash（默认，~35s/次）
#   z-ai/glm-5.3（~10-60s/次）
#   z-ai/glm-5.3-flash（~60s/次，排队时更慢）
# 注意：这些都是推理模型，回复含独立 reasoning_content，answer 在 content；
# max_tokens 需给推理留余量（本 app 已处理：空 content 自动提额重试）。
# ASTOCK_MODEL=deepseek-ai/deepseek-v4.1-flash

# ── 可选：选股参数覆盖 ─────────────────────────────────────────
# ASTOCK_CANDIDATE_COUNT=30    # 量化初筛候选数
# ASTOCK_TRIAGE_COUNT=15       # LLM 快筛通过数
# ASTOCK_MAX_PICKS=10          # 最终选股上限
# ASTOCK_MIN_PRICE=2.0         # 最低股价（面值退市防护）
# ASTOCK_MIN_AMOUNT=1.0        # 最低成交额（亿元，流动性）
# ASTOCK_MIN_MCAP=20.0         # 最低市值（亿元）

# ── 可选：复盘与策略版本（默认开，每次选股后复盘上一次 run）──────
# ASTOCK_REVIEW=0              # 关闭复盘（不生成新策略版本）
# ASTOCK_STRATEGY_VERSION=2    # 钉住策略版本（缺省=最新版本；无版本=内置默认策略）

# ── 可选：东财防封限速（批量场景调大）──────────────────────────
# EM_MIN_INTERVAL=1.5
